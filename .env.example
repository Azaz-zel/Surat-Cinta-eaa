# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public HTTPS address of the site. Used for the link preview image (WhatsApp etc.).
# Share links follow the address you open the admin from, so open /admin via HTTPS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for the Playwright end-to-end test
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
